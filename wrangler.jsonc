{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  // Cloudflare Workers Builds does NOT run wrangler custom builds (build.command is ignored there).
  // Dashboard: Build command = "npm ci && npm run build:cf", Deploy command = "npx wrangler deploy"
  // Or a single deploy step: "npm run deploy" (see package.json).
  // This block still helps local `wrangler deploy` when OpenNext delegation is not used.
  "build": {
    "command": "npm run build:cf"
  },
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio"
    }
  ]
}
