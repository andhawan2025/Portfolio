{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  // Workers Builds ignores wrangler "build.command". Default "npx wrangler deploy" also skips your
  // build and delegates to opennextjs-cloudflare deploy, which then fails without .open-next/.
  // Set Deploy command to ONE of:
  //   npm run deploy
  //   node scripts/cloudflare-deploy.mjs
  // Optional Build command: "npm ci" (or "pnpm install --frozen-lockfile"); deploy script builds if needed.
  // This "build" block still helps local `wrangler deploy` when OpenNext delegation is not used.
  "build": {
    "command": "npm run build:cf"
  },
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio"
    }
  ]
}
